<!--
  Marain (app.marain.learn) — Android 8–11 (API 26–30) Auto Backup exclusion rules.
  All app data is strictly local-only and must never leave the device.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
