{
  "name": "zero2ai-studio",
  "version": "1.0.0",
  "description": "Zero2AI Studio — Interactive Desktop App to learn AI from zero to building websites and apps",
  "author": "Zero2AI",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "sync-curriculum": "node scripts/sync-curriculum.mjs",
    "dev:web": "vite --port 5173",
    "build:electron": "tsc -p tsconfig.electron.json",
    "dev": "npm run build:electron && concurrently -k \"vite --port 5173\" \"wait-on http://localhost:5173 && VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "package:linux": "npm run build && electron-builder --linux AppImage tar.gz",
    "package:dir": "npm run build && electron-builder --linux dir"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.zero2ai.studio",
    "productName": "Zero2AI Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "tar.gz",
          "arch": ["x64"]
        }
      ],
      "category": "Education",
      "icon": "build/icon.png",
      "executableName": "zero2ai-studio",
      "desktop": {
        "Name": "Zero2AI Studio",
        "Comment": "From Zero to Building with AI — Interactive Lessons & Hands-On Labs",
        "Categories": "Education;Development;"
      }
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.education",
      "icon": "build/icon.png"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png"
    }
  }
}
